{
  "swagger": "2.0",
  "info": {
    "title": "Customers API Swagger 2.0",
    "version": "1.0.0"
  },
  "host": "api.example.com",
  "basePath": "/v1",
  "schemes": ["https"],
  "paths": {
    "/customers": {
      "get": {
        "operationId": "getCustomers",
        "summary": "List customers",
        "parameters": [
          {
            "name": "channel",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer"
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      },
      "post": {
        "operationId": "createCustomer",
        "summary": "Create customer",
        "parameters": [
          {
            "name": "channel",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Customer"
            }
          }
        ],
        "responses": {
          "201": { "description": "Created" }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "operationId": "getCustomerById",
        "summary": "Get customer by id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer"
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    }
  },
  "definitions": {
    "Base": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "id": { "type": "integer", "readOnly": true },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "readOnly": true },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "PENDING"] },
        "code": { "type": "string", "pattern": "^[A-Z]{2}\\d{4}$" },
        "dob": { "type": "string", "format": "date" },
        "notes": { "type": "string", "x-nullable": true }
      }
    },
    "Address": {
      "type": "object",
      "required": ["city"],
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string" },
        "zipCode": { "type": "string" }
      }
    },
    "Contact": {
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" }
      }
    },
    "Customer": {
      "allOf": [
        { "$ref": "#/definitions/Base" },
        {
          "type": "object",
          "properties": {
            "address": { "$ref": "#/definitions/Address" },
            "billing": {
              "type": "object",
              "properties": {
                "city": { "type": "string" }
              }
            },
            "contacts": {
              "type": "array",
              "items": { "$ref": "#/definitions/Contact" }
            },
            "meta": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      ]
    }
  }
}
