{
  "name": "Mock 10 CustIds",
  "baseUrl": "http://127.0.0.1:8089",
  "specPath": "mock_openapi.json",
  "testCases": [
    {
      "name": "Generate Access Token",
      "category": "Authentication",
      "method": "POST",
      "url": "{{baseUrl}}/generateAccessToken",
      "headers": {
        "Content-Type": "application/json"
      },
      "bodyTemplate": "{}",
      "expectedStatus": 200,
      "tokenProvider": true,
      "tokenJsonPath": "$.access_token",
      "tokenVariableName": "accessToken"
    },
    {
      "name": "Cust 100001",
      "category": "Customer",
      "method": "POST",
      "url": "{{baseUrl}}/getCustDetails",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer {{accessToken}}"
      },
      "bodyTemplate": "{\n  \"SessionContext\": {\n    \"BankCode\": \"abcd\",\n    \"refid\": \"ref-1\",\n    \"userid\": \"tjon\"\n  },\n  \"CustId\": \"000000\"\n}",
      "expectedStatus": 200,
      "expectedBodyTemplate": "{\n  \"CustId\": \"100001\",\n  \"AccountNum\": null,\n  \"Email\": \"cust100001@example.com\",\n  \"Mobile\": \"9000100001\"\n}",
      "usesTokenFrom": [
        "accessToken"
      ]
    },
